{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-codebase-index"],



  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.6": { "name": "qwen3.6:latest" },
        "llama3.1:8b": { "name": "llama3.1:8b" },
        "deepseek-coder:latest": { "name": "deepseek-coder:latest" }
      }
    }
    
  },

  "model": "ollama/qwen3.6:latest",
  "small_model": "ollama/qwen3.6:latest",

  "lsp": {
    "r": {
      "command": ["R", "--slave", "-e", "languageserver::run()"],
      "extensions": [".R", ".r"]
    },
    "java": {
       "command": ["jdtls"],
       "extensions": [".java"]
    }
  }

  
}




